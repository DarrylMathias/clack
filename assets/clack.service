# systemd user unit for clack (§5.7).
# Install at ~/.config/systemd/user/clack.service
[Unit]
Description=Clack Keyboard Sounds
After=graphical-session.target pipewire.service wireplumber.service

[Service]
ExecStart=%h/.local/bin/clack daemon
Restart=on-failure
RestartSec=3
Environment=PIPEWIRE_NODE=alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink
Environment=PIPEWIRE_LATENCY=256/48000

[Install]
WantedBy=default.target
