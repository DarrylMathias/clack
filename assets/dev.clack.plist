<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for clack on macOS (§5.7).
     Install at ~/Library/LaunchAgents/dev.clack.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.clack</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/clack</string>
        <string>daemon</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/clack.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/clack.err</string>
</dict>
</plist>
